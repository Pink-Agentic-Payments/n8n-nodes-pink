{
	"name": "n8n-nodes-pink",
	"version": "0.1.0",
	"description": "n8n community node for Pink Agentic AI Payments: let an AI agent or workflow pay within the spending rules a company sets (per-agent budgets, single-payment caps, payee allow-lists, human approval thresholds), checked against the Pink sandbox before any credential is issued.",
	"license": "MIT",
	"homepage": "https://pinkwallet.com/agentic/developers/",
	"keywords": [
		"n8n-community-node-package",
		"ai-agents",
		"agent-payments",
		"payments"
	],
	"author": {
		"name": "PinkWallet",
		"email": "support@pinkwallet.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Pink-Agentic-Payments/n8n-nodes-pink.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PinkAgenticPaymentsApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/PinkAgenticPayments/PinkAgenticPayments.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.9.9",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
